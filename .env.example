# ==============================================================================
# 404 FOUND — Root Deployment Configuration Example
# ==============================================================================

# Backend Server Port
PORT=5001

# Production Environment
NODE_ENV=production

# Strong JWT Secret Key (Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=replace_with_a_cryptographically_secure_random_string_min_32_chars

# Public URLs
CLIENT_URL=https://campusfind.edu
CORS_ORIGIN=https://campusfind.edu

# Persistent Storage Paths
DB_PATH=/data/lost_and_found.db
UPLOAD_DIR=/data/uploads

# Client demo toggle ('false' in production)
VITE_ENABLE_DEMO_LOGIN=false
