{
  "name": "404-found",
  "version": "1.0.0",
  "description": "Production-grade AI-powered Lost & Found platform for university campuses",
  "private": true,
  "main": "electron/main.js",
  "author": "Campus Safety & Tech Office",
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"SERVER,CLIENT\" -c \"cyan.bold,magenta.bold\" \"npm --prefix server run dev\" \"npm --prefix client run dev\"",
    "dev:electron": "concurrently -k -p \"[{name}]\" -n \"SERVER,CLIENT,DESKTOP\" -c \"cyan.bold,magenta.bold,yellow.bold\" \"npm --prefix server run dev\" \"npm --prefix client run dev\" \"electron .\"",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "start": "npm --prefix server start",
    "start:prod": "npm run build && npm --prefix server start",
    "lint": "npm --prefix client run lint",
    "test": "node scripts/test-runner.js all",
    "test:flow": "node scripts/test-runner.js flow",
    "test:audit": "node scripts/test-runner.js audit",
    "test:security": "node scripts/test-runner.js security",
    "test:e2e": "node scripts/test-browser-e2e.js",
    "test:all": "node scripts/test-runner.js all",
    "launch": "node scripts/launch-app.js",
    "seed": "npm --prefix server run seed",
    "backup": "npm --prefix server run backup",
    "restore": "npm --prefix server run restore",
    "install:all": "npm install && npm --prefix server install && npm --prefix client install",
    "prebuild:electron": "node scripts/prepare-desktop-runtime.js && npm --prefix client run build",
    "build:electron": "npm run prebuild:electron && electron-builder --win nsis",
    "dist": "npm run build:electron"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "edu.campus.404found",
    "productName": "404 FOUND",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "package.json",
      "electron/**/*",
      "client/dist/**/*"
    ],
    "extraResources": [
      {
        "from": "server",
        "to": "server",
        "filter": [
          "package.json",
          "src/**/*",
          "!uploads/**/*",
          "!lost_and_found.db*",
          "!backups/**/*",
          "!test*.js"
        ]
      },
      {
        "from": "server/node_modules",
        "to": "server/node_modules"
      },
      {
        "from": "desktop-runtime/bin/node.exe",
        "to": "runtime/node.exe"
      },
      {
        "from": "client/dist",
        "to": "client/dist"
      }
    ],
    "asar": true,
    "asarUnpack": [
      "electron/**/*",
      "client/dist/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "404 FOUND",
      "uninstallDisplayName": "404 FOUND (Campus Lost & Found)"
    }
  }
}
