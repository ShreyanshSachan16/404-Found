# ==============================================================================
# 404 FOUND — Server Environment Configuration
# ==============================================================================

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=production

# Server HTTP Port
PORT=5001

# Production Secret for JWT Tokens (Must be a high-entropy secret in production)
JWT_SECRET=replace_with_a_cryptographically_secure_random_string_min_32_chars

# JWT Session Expiry
JWT_EXPIRES_IN=7d

# Allowed CORS Origin(s) (Comma-separated for multiple origins, e.g. https://campusfind.edu)
CORS_ORIGIN=https://campusfind.edu

# Public Client App URL (Used in QR Code generation for physical labels)
CLIENT_URL=https://campusfind.edu

# Persistent Storage Paths (CRITICAL: Must point to a persistent volume, NOT ephemeral storage)
# Example for Docker persistent volume mounted at /data:
# DB_PATH=/data/lost_and_found.db
# UPLOAD_DIR=/data/uploads
DB_PATH=./lost_and_found.db
UPLOAD_DIR=./uploads
